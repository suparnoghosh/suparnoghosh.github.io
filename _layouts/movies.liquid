---
layout: page
---

{{ content }}

{% if page.collection and page.collection.size > 0 %}
  {% assign collection = site[page.collection] %}

  {% if collection and collection.size > 0 %}

    {% assign sorted_movies = collection | sort: "categories" %}

    {% for item in sorted_movies %}

      {% assign current_category = item.categories | first %}

      {% if current_category != category %}
        {% unless forloop.first %}
          </ul>
        {% endunless %}

        <h1 id="{{ current_category }}">
          <a href="#{{ current_category }}">
            {{ current_category | capitalize }}
          </a>
        </h1>

        <ul>

        {% assign category = current_category %}
      {% endif %}

      <figure class="cover">
        <a class="cover-link" href="{{ item.url | relative_url }}">

          {% if item.poster %}
            <img
              alt="{{ item.title }} poster"
              src="{{ item.poster | prepend: page.posters | relative_url }}"
              style="height:200px"
            >
          {% endif %}

          {% if item.status %}
            {% assign statuses = 'watched,watching,queued' | split: ',' %}
            {% assign status = item.status | downcase | strip %}

            {% if statuses contains status %}
              <figcaption class="{{ status }}">
                {{ status | upcase }}
              </figcaption>
            {% else %}
              <figcaption class="uncategorized">
                UNCATEGORIZED
              </figcaption>
            {% endif %}
          {% else %}
            <figcaption class="uncategorized">
              UNCATEGORIZED
            </figcaption>
          {% endif %}

        </a>
      </figure>

      {% if forloop.last %}
        </ul>
      {% endif %}

    {% endfor %}

  {% endif %}
{% endif %}
